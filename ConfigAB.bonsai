<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.8.5"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns:rx="clr-namespace:Bonsai.Reactive;assembly=Bonsai.Core"
                 xmlns:sys="clr-namespace:System;assembly=mscorlib"
                 xmlns:io="clr-namespace:Bonsai.IO;assembly=Bonsai.System"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Workflow>
    <Nodes>
      <Expression xsi:type="rx:BehaviorSubject" TypeArguments="sys:Boolean">
        <rx:Name>RecOn</rx:Name>
      </Expression>
      <Expression xsi:type="rx:BehaviorSubject" TypeArguments="sys:Boolean">
        <rx:Name>isOn</rx:Name>
      </Expression>
      <Expression xsi:type="rx:BehaviorSubject" TypeArguments="sys:Boolean">
        <rx:Name>Switch</rx:Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="StringProperty">
          <Value>C:\Users\Manip7\Documents\data\Bonsai_data\</Value>
        </Combinator>
      </Expression>
      <Expression xsi:type="rx:BehaviorSubject">
        <Name>pathName</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="StringProperty">
          <Value>TestGcamp8</Value>
        </Combinator>
      </Expression>
      <Expression xsi:type="rx:BehaviorSubject">
        <Name>expeName</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="StringProperty">
          <Value>Homecage</Value>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="StringProperty" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:Timestamp" />
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>Timestamp</Selector>
      </Expression>
      <Expression xsi:type="Format">
        <Format>{0}_{1:D2}_{2:D2}</Format>
        <Selector>Hour,Minute,Second</Selector>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:CombineLatest" />
      </Expression>
      <Expression xsi:type="Format">
        <Format>{0}_{1}</Format>
        <Selector>Item1,Item2</Selector>
      </Expression>
      <Expression xsi:type="rx:BehaviorSubject">
        <Name>trialName</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="StringProperty" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:Timestamp" />
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>Timestamp</Selector>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>pathName</Name>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>expeName</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="StringProperty" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:Timestamp" />
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>Timestamp</Selector>
      </Expression>
      <Expression xsi:type="Format">
        <Format>{0}_{1:D2}_{2:D2}</Format>
        <Selector>Year,Month,Day</Selector>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>trialName</Name>
      </Expression>
      <Expression xsi:type="ExternalizedMapping">
        <Property Name="Value" DisplayName="recTSBaseName" Description="Base name for recording onset timetamp" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="StringProperty">
          <Value>recTS_.csv</Value>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:CombineLatest" />
      </Expression>
      <Expression xsi:type="Format">
        <Format>{0}/RecTS/{1}/{2}/{3}/{4}</Format>
        <Selector>Item1,Item2,Item3,Item4,Item5</Selector>
      </Expression>
      <Expression xsi:type="PropertyMapping">
        <PropertyMappings>
          <Property Name="FileName" />
        </PropertyMappings>
      </Expression>
      <Expression xsi:type="io:CsvWriter">
        <io:FileName>C:\Users\Manip7\Documents\data\Bonsai_data\/RecTS/TestGcamp8/2025_01_08/Homecage_17_21_42/recTS_.csv</io:FileName>
        <io:Append>false</io:Append>
        <io:Overwrite>false</io:Overwrite>
        <io:Suffix>Timestamp</io:Suffix>
        <io:IncludeHeader>false</io:IncludeHeader>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="BooleanProperty">
          <Value>false</Value>
        </Combinator>
      </Expression>
      <Expression xsi:type="MulticastSubject">
        <Name>RecOn</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="BooleanProperty">
          <Value>false</Value>
        </Combinator>
      </Expression>
      <Expression xsi:type="MulticastSubject">
        <Name>isOn</Name>
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="Extensions\OEBoardMultiple.bonsai">
        <nChannelsPerAnimal>32</nChannelsPerAnimal>
        <BoardChannelsOEForDisplay>
          <int>0</int>
        </BoardChannelsOEForDisplay>
        <BoardPortOE>9001</BoardPortOE>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>Item1</Selector>
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="Extensions\saveMatrixData.bonsai">
        <animalID>Lou</animalID>
        <timestampsBaseName>OE_TS_1_.csv</timestampsBaseName>
        <OEdataBasename>OE_data_1_.bin</OEdataBasename>
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="Extensions\timing2.bonsai">
        <delayEnd>PT0S</delayEnd>
        <trialDuration>PT15S</trialDuration>
        <continuous>true</continuous>
        <stopTrig>H</stopTrig>
        <switchName>RecOn</switchName>
        <delayStart>PT0S</delayStart>
        <interTrialDuration>PT5S</interTrialDuration>
        <shouldRepeat>false</shouldRepeat>
        <startTrig>G</startTrig>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>Item2</Selector>
      </Expression>
      <Expression xsi:type="Disable">
        <Builder xsi:type="MemberSelector">
          <Selector>Item2</Selector>
        </Builder>
      </Expression>
      <Expression xsi:type="Disable">
        <Builder xsi:type="IncludeWorkflow" Path="Extensions\saveMatrixData.bonsai">
          <timestampsBaseName>OE_TS_2_.csv</timestampsBaseName>
          <animalID>none</animalID>
          <OEdataBasename>OE_data_2_.bin</OEdataBasename>
        </Builder>
      </Expression>
      <Expression xsi:type="Disable">
        <Builder xsi:type="IncludeWorkflow" Path="Extensions\timing.bonsai">
          <delayEnd>PT0S</delayEnd>
          <trialDuration>PT5M</trialDuration>
          <triggerStop>F</triggerStop>
          <triggerRec>B</triggerRec>
        </Builder>
      </Expression>
      <Expression xsi:type="Disable">
        <Builder xsi:type="MemberSelector">
          <Selector>Item2</Selector>
        </Builder>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>TTLin</Name>
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="Extensions\MiniscopeImagingAB.bonsai">
        <LedONvalue>15</LedONvalue>
        <Index>0</Index>
        <Focus>-62.8</Focus>
        <SensorGain>Medium</SensorGain>
        <FramesPerSecond>Fps30</FramesPerSecond>
        <LedRespectsTrigger>false</LedRespectsTrigger>
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="Extensions\saveMatrixData_forMiniscope_MB.bonsai">
        <animalID>Lou</animalID>
        <videoBaseName>miniscope_.avi</videoBaseName>
        <timestampsBaseName>miniscopeTS_.csv</timestampsBaseName>
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="Extensions\timing2.bonsai">
        <delayEnd>PT0S</delayEnd>
        <trialDuration>PT5M</trialDuration>
        <continuous>false</continuous>
        <stopTrig>H</stopTrig>
        <switchName>RecOn</switchName>
        <delayStart>PT30S</delayStart>
        <interTrialDuration>PT14M30S</interTrialDuration>
        <shouldRepeat>true</shouldRepeat>
        <startTrig>G</startTrig>
      </Expression>
      <Expression xsi:type="Disable">
        <Builder xsi:type="MemberSelector">
          <Selector>ImageData</Selector>
        </Builder>
      </Expression>
      <Expression xsi:type="Disable">
        <Builder xsi:type="MemberSelector">
          <Selector>Value</Selector>
        </Builder>
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="Extensions\CheeseboardWebcam_noAutoSave.bonsai">
        <CaptureProperties>
          <CapturePropertyAssignment>
            <Property>Exposure</Property>
            <Value>-5</Value>
          </CapturePropertyAssignment>
          <CapturePropertyAssignment>
            <Property>Brightness</Property>
            <Value>100</Value>
          </CapturePropertyAssignment>
          <CapturePropertyAssignment>
            <Property>Focus</Property>
            <Value>0</Value>
          </CapturePropertyAssignment>
        </CaptureProperties>
        <Index>1</Index>
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="Extensions\saveMatrixData_forWebcam.bonsai">
        <animalID>Lou</animalID>
        <videoBaseName>webcam_.avi</videoBaseName>
        <timestampsBaseName>webcamTS_.csv</timestampsBaseName>
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="Extensions\timing2.bonsai">
        <delayEnd>PT0S</delayEnd>
        <trialDuration>PT6M</trialDuration>
        <continuous>false</continuous>
        <stopTrig>H</stopTrig>
        <switchName />
        <delayStart>PT0S</delayStart>
        <interTrialDuration>PT14M</interTrialDuration>
        <shouldRepeat>true</shouldRepeat>
        <startTrig>G</startTrig>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>ImageData</Selector>
      </Expression>
      <Expression xsi:type="Disable">
        <Builder xsi:type="IncludeWorkflow" Path="Extensions\commutator-keypress-control.bonsai" />
      </Expression>
      <Expression xsi:type="Disable">
        <Builder xsi:type="IncludeWorkflow" Path="Extensions\SleepCagesWebcam_noAutoSave.bonsai">
          <Index>1</Index>
          <CaptureProperties>
            <CapturePropertyAssignment>
              <Property>Brightness</Property>
              <Value>100</Value>
            </CapturePropertyAssignment>
            <CapturePropertyAssignment>
              <Property>Exposure</Property>
              <Value>-6</Value>
            </CapturePropertyAssignment>
          </CaptureProperties>
        </Builder>
      </Expression>
      <Expression xsi:type="Disable">
        <Builder xsi:type="MemberSelector">
          <Selector>ImageData</Selector>
        </Builder>
      </Expression>
    </Nodes>
    <Edges>
      <Edge From="3" To="4" Label="Source1" />
      <Edge From="5" To="6" Label="Source1" />
      <Edge From="7" To="12" Label="Source1" />
      <Edge From="8" To="9" Label="Source1" />
      <Edge From="9" To="10" Label="Source1" />
