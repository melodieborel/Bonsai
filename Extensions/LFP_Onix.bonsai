        <io:IncludeHeader>false</io:IncludeHeader>
        <io:Selector>Clock,Delay,Status,Origin</io:Selector>
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="Extensions\timing.bonsai">
        <delayEnd>PT0S</delayEnd>
        <trialDuration>PT10S</trialDuration>
        <continuous>true</continuous>
        <stopTrig>F</stopTrig>
