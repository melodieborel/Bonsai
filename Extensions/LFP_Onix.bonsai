          <dsp:Suffix>Timestamp</dsp:Suffix>
          <dsp:Overwrite>false</dsp:Overwrite>
          <dsp:Layout>ColumnMajor</dsp:Layout>
        </Combinator>
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="Extensions\timing.bonsai">
        <delayEnd>PT0S</delayEnd>
        <trialDuration>PT10S</trialDuration>
        <continuous>true</continuous>
        <stopTrig>F</stopTrig>
        <switchName xsi:nil="true" />
        <delayStart>PT0S</delayStart>
        <interTrialDuration>PT10S</interTrialDuration>
