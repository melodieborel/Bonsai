          <onix1:DeviceName>HeadstageNeuropixelsV1e/NeuropixelsV1</onix1:DeviceName>
          <onix1:BufferSize>36</onix1:BufferSize>
          <onix1:OrderByDepth>true</onix1:OrderByDepth>
        </Combinator>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>Clock</Selector>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>pathName</Name>
      </Expression>
      <Expression xsi:type="ExternalizedMapping">
        <Property Name="Value" DisplayName="clockBaseName" />
