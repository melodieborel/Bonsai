        <Name>HeadstageLFP</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="onix1:StartAcquisition">
          <onix1:ReadSize>2048</onix1:ReadSize>
          <onix1:WriteSize>2048</onix1:WriteSize>
        </Combinator>
      </Expression>
      <Expression xsi:type="rx:BehaviorSubject">
        <Name>acqStarted</Name>
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="Extensions\LFP_Onix.bonsai">
        <clockBN>LFP_clock_.raw</clockBN>
        <dataBN>LFP_LFPdata_.raw</dataBN>
        <recovryMaskBN>LFP_recovryMask_.raw</recovryMaskBN>
        <DCDataBN>LFP_DCdata_.raw</DCDataBN>
        <startTimeBN>LFP_startTime_.csv</startTimeBN>
        <portStatus>port-status_.csv</portStatus>
        <TriggerBN>rhs2116trigger_.csv</TriggerBN>
      </Expression>
      <Expression xsi:type="Disable">
        <Builder xsi:type="Combinator">
          <Combinator xsi:type="dsp:ConvertScale">
            <dsp:Depth>F32</dsp:Depth>
            <dsp:Scale>1</dsp:Scale>
            <dsp:Shift>-512</dsp:Shift>
          </Combinator>
        </Builder>
      </Expression>
      <Expression xsi:type="p1:WaveformVisualizerBuilder">
        <p1:SampleRate>30000</p1:SampleRate>
        <p1:MaxSamplesPerChannel>1920</p1:MaxSamplesPerChannel>
        <p1:ChannelHeight xsi:nil="true" />
        <p1:Timebase xsi:nil="true" />
        <p1:ColorGrouping xsi:nil="true" />
        <p1:RangeAmplitude>100</p1:RangeAmplitude>
        <p1:RangeOffset xsi:nil="true" />
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>acqStarted</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:SubscribeWhen" />
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="Extensions\Neuropixel.bonsai">
        <PortStatusBN>NP_PortStatus_.csv</PortStatusBN>
        <LFPDataBaseName>NP_LFPdata_.raw</LFPDataBaseName>
        <NPXChannelsOE>
          <int>1</int>
          <int>2</int>
          <int>3</int>
          <int>5</int>
          <int>6</int>
          <int>7</int>
          <int>9</int>
          <int>10</int>
          <int>11</int>
          <int>13</int>
          <int>14</int>
          <int>15</int>
        </NPXChannelsOE>
        <NPXPortOE>9002</NPXPortOE>
        <spikeDataBaseName>NP_spikes_.raw</spikeDataBaseName>
        <clockBaseName>NP_timestamps_.raw</clockBaseName>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="dsp:ConvertScale">
          <dsp:Depth>F32</dsp:Depth>
          <dsp:Scale>1</dsp:Scale>
          <dsp:Shift>-512</dsp:Shift>
        </Combinator>
      </Expression>
      <Expression xsi:type="p1:WaveformVisualizerBuilder">
        <p1:SampleRate>30000</p1:SampleRate>
        <p1:MaxSamplesPerChannel>1920</p1:MaxSamplesPerChannel>
        <p1:ChannelHeight xsi:nil="true" />
        <p1:Timebase xsi:nil="true" />
        <p1:ColorGrouping xsi:nil="true" />
        <p1:RangeAmplitude>100</p1:RangeAmplitude>
        <p1:RangeOffset xsi:nil="true" />
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>acqStarted</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:SubscribeWhen" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="onix1:PolledBno055Data">
          <onix1:DeviceName>HeadstageNeuropixelsV1e/PolledBno055</onix1:DeviceName>
          <onix1:PolledRegisters>All</onix1:PolledRegisters>
        </Combinator>
      </Expression>
      <Expression xsi:type="Disable">
        <Builder xsi:type="io:CsvWriter">
          <io:FileName>bno055_.csv</io:FileName>
          <io:Append>false</io:Append>
          <io:Overwrite>false</io:Overwrite>
          <io:Suffix>FileCount</io:Suffix>
          <io:IncludeHeader>false</io:IncludeHeader>
          <io:Selector>Clock,EulerAngle,Quaternion,Acceleration,Gravity,Temperature</io:Selector>
        </Builder>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>Quaternion</Selector>
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="OpenEphys.Commutator:AutoCommutator.bonsai">
        <PortName>COM4</PortName>
        <Enable>true</Enable>
        <EnableLed>true</EnableLed>
      </Expression>
